@model IEnumerable<IndiciBVBWeb.Models.IndiciBVB>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<div style="display:flex; gap:10px; align-items:center;">
    <form asp-action="UpdateIndiciBVB" method="post">
        <button type="submit" class="btn btn-primary">Sync</button>
    </form>

    <form asp-action="UpdateIndiciBVB2" method="post">
        <button type="submit" class="btn btn-primary">Sync Secondary</button>
    </form>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                Nume
            </th>
            <th>
                ValoareUnitara
            </th>

            <th>
                CastigValoare
            </th>
            <th>
                CastigProcent
            </th>
            <th>
                Data
            </th>
            <th>
                Sursa
            </th>
            <th>
                Operatii
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nume)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ValoareUnitara)
            </td>
                <td>
                    @if (item.Sursa == "BVB")
                    {
                        @($"{item.CastigValoare}/Ora")
                    }
                    else if (item.Sursa == "Primet")
                    {
                        @($"{item.CastigValoare}/Zi")
                    }
                    else
                    {
                        @Html.DisplayFor(modelItem => item.CastigValoare)
                    }
                </td>

                <td>
                    @if (item.Sursa == "BVB")
                    {
                        @($"{item.CastigProcent}%/Ora")
                    }
                    else if (item.Sursa == "Primet")
                    {
                        @($"{item.CastigProcent}%/Zi")
                    }
                    else
                    {
                        @Html.DisplayFor(modelItem => item.CastigProcent)
                    }
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.Data)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Sursa)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
